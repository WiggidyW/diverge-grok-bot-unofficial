# The unofficial Grok Bot agent image: a thin wrapper, whose every run
# is a turn of its own tool (`grok-bot-unofficial-tool`).
#
# The container proxy is NOT in this image. The host injects it at
# runtime, and it may not be up at all until a request comes, which is
# why the agent touches nothing of the proxy's (the daemon) until its
# first run.
#
# Build from this repository's ROOT, since the crate is a member of its
# workspace:
#
#     podman build -f grok-bot-unofficial-agent/Containerfile .
#
# The Diverge SDK comes from GitHub at the commit the workspace pins,
# so the build needs github.com reachable and nothing else beside this
# repository.

# The same Rust image, by the same digest, as the Diverge agent images.
FROM docker.io/library/rust:1.98.0@sha256:271849e998ffce5776454bbf98c5dc21baafc854ff8e566197908d3aca9a81e8 AS build

WORKDIR /build

# The whole workspace: its manifest names both members, so both are
# there, and only this one is built.
COPY Cargo.toml Cargo.lock ./
COPY grok-bot-unofficial-agent grok-bot-unofficial-agent
COPY grok-bot-unofficial-tool grok-bot-unofficial-tool

RUN cargo build --release --locked -p grok-bot-unofficial-agent

# Debian stable. Not pinned by digest yet; pin it when the image is
# first published.
FROM docker.io/library/debian:trixie-slim

COPY --from=build /build/target/release/grok-bot-unofficial-agent /usr/local/bin/grok-bot-unofficial-agent

# The image's arguments schema and its description, read by the proxy.
COPY grok-bot-unofficial-agent/.diverge /.diverge

# The agent's own server, on the loopback: 8080, or whatever `PORT`
# names. Nothing is exposed: the proxy the host injects is the only
# thing that dials it, and it is beside it.

ENTRYPOINT ["/usr/local/bin/grok-bot-unofficial-agent"]
