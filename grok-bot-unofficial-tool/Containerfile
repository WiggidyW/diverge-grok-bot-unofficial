# The unofficial Grok Bot tool image: the program, and the desktop it
# runs the Grok Bot app and a browser on (a display, a window manager,
# a taskbar, Chromium and the noVNC web client, all Debian's own
# packages).
#
# The container proxy is NOT in this image. The host injects it at
# runtime, and it may not be up at all until a request comes.
#
# The image ships NO Grok Bot app. The app is the vendor's software and
# is not redistributed here: the program fetches the current release
# from the vendor the moment it starts (src/install.rs) and installs it
# with apt, so a starting container needs the vendor's download hosts
# and the Debian mirrors reachable, and runs as root.
#
# Build from this repository's ROOT, since the crate is a member of its
# workspace:
#
#     podman build -f grok-bot-unofficial-tool/Containerfile .
#
# The Diverge SDK comes from GitHub at the commit the workspace pins,
# so the build needs github.com reachable and nothing else beside this
# repository.

# The same Rust image, by the same digest, as the Diverge agent images.
FROM docker.io/library/rust:1.98.0@sha256:271849e998ffce5776454bbf98c5dc21baafc854ff8e566197908d3aca9a81e8 AS build

WORKDIR /build

# The whole workspace: its manifest names both members, so both are
# there, and only this one is built.
COPY Cargo.toml Cargo.lock ./
COPY grok-bot-unofficial-agent grok-bot-unofficial-agent
COPY grok-bot-unofficial-tool grok-bot-unofficial-tool

RUN cargo build --release --locked -p grok-bot-unofficial-tool

# Debian stable. Not pinned by digest yet; pin it when the image is
# first published.
FROM docker.io/library/debian:trixie-slim

# CA certificates so TLS works at all, for the webhook, the vendor's
# release feed and the package's download. Then the desktop: the
# display (Xvnc), the window manager and taskbar, the session bus, the
# browser, what opens a link in the default program, fonts, and the
# noVNC web client the frontend serves. Nothing of the app's own
# dependencies is installed here: apt resolves them at startup from
# what the package itself declares.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        tigervnc-standalone-server \
        openbox \
        tint2 \
        dbus-x11 \
        chromium \
        xdg-utils \
        fonts-liberation \
        fonts-noto-color-emoji \
        novnc \
    && rm -rf /var/lib/apt/lists/*

# The browser's wrapper and launcher, and the desktop's menu.
COPY --chmod=755 grok-bot-unofficial-tool/desktop/tool-browser /usr/local/bin/tool-browser
COPY grok-bot-unofficial-tool/desktop/tool-browser.desktop /usr/share/applications/tool-browser.desktop
COPY grok-bot-unofficial-tool/desktop/menu.xml /root/.config/openbox/menu.xml

# The desktop's display, and whose it is.
ENV DISPLAY=:1 HOME=/root

COPY --from=build /build/target/release/grok-bot-unofficial-tool /usr/local/bin/grok-bot-unofficial-tool

# The image's arguments schema and its description, read by the proxy.
COPY grok-bot-unofficial-tool/.diverge /.diverge

# The program's own server, on the loopback: 8080, or whatever `PORT`
# names. Nothing is exposed: the proxy the host injects is the only
# thing that dials it, and it is beside it.

ENTRYPOINT ["/usr/local/bin/grok-bot-unofficial-tool"]
